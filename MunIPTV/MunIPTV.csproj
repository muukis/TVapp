<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android only: no iOS / MacCatalyst / Windows targets. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>MunIPTV</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>MunIPTV</ApplicationTitle>
		<ApplicationId>com.muukis.muniptv</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" ForegroundScale="0.65" Color="#0F1419" />
		<MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0F1419" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<!-- Bundled default playlist (same file as TVapp/playlists/index.country.m3u). -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<!-- Toast + MediaElement (ExoPlayer/Media3 on Android, HLS included). -->
		<PackageReference Include="CommunityToolkit.Maui" Version="16.0.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="11.0.0" />
	</ItemGroup>

</Project>
