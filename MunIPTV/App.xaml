<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="MunIPTV.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <Color x:Key="Background">#0F1419</Color>
        <Color x:Key="Surface">#1B2430</Color>
        <Color x:Key="SurfaceHigh">#263344</Color>
        <Color x:Key="Accent">#3D8BFF</Color>
        <Color x:Key="Danger">#E5484D</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextMuted">#8A97A8</Color>

        <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
            <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        </Style>
        <Style x:Key="PageTitle" TargetType="Label">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="16,16,16,8" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHigh}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Application.Resources>
</Application>
